# Required: shared secret for the Sanity -> /api/revalidate webhook.
# Generate one with: openssl rand -hex 32
SANITY_REVALIDATE_SECRET=replace_with_a_long_random_string

# Optional. Defaults are baked into lib/sanity.ts (pddoyk9z / production).
NEXT_PUBLIC_SANITY_PROJECT_ID=pddoyk9z
NEXT_PUBLIC_SANITY_DATASET=production
